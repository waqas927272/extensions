{
  "manifest_version": 3,
  "name": "VCA Jobs Scraper",
  "version": "1.1.15",
  "description": "Scrape veterinarian jobs from VCA Careers",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.vcacareers.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.vcacareers.com/*"],
      "js": ["salary-resolver.js", "content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VCA Jobs Scraper"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "detail-extractor.js",
        "salary-resolver.js",
        "google-maps-scraper.js",
        "google-search-scraper.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
